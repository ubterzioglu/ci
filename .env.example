# ---------------------------------------------------------------------------
# Çi Neo Cucina — environment variable template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
# Temporary domain in use: https://notyetbro.club
# Final domain (set when live): https://www.cineocucina.com
NEXT_PUBLIC_SITE_URL=https://notyetbro.club

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: new-style secret API key (server only) and CLI access token
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
# Direct Postgres connection string (used by the seed script)
SUPABASE_DB_URL=

# --- Translation (DeepL) — OPTIONAL ----------------------------------------
# Used by `pnpm i18n:translate` to generate EN/DE content from Turkish source.
DEEPL_API_KEY=

# --- Outgoing email (Zoho SMTP) — OPTIONAL ----------------------------------
# Mail is sent from the restaurant's own Zoho mailbox, which also receives it,
# so no separate sender-domain verification is needed. Zoho requires an
# APP-SPECIFIC password (Zoho -> My Account -> Security -> App Passwords); the
# normal account password is rejected by SMTP.
# Use smtp.zoho.eu for EU-region accounts, smtp.zoho.com otherwise.
# With these unset the app still stores submissions and just skips the email.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=info@cineocucina.com
ZOHO_SMTP_PASSWORD=
# Defaults to the SMTP user; Zoho rejects a From the account may not send as.
MAIL_FROM=Çi Neo Cucina <info@cineocucina.com>

# Where form submissions are announced.
RESERVATION_NOTIFICATION_EMAIL=info@cineocucina.com
CONTACT_NOTIFICATION_EMAIL=info@cineocucina.com
