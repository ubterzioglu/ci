# ---------------------------------------------------------------------------
# Çi Neo Cucina — environment variable template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
# Must match the domain configured in Coolify, including the www.
NEXT_PUBLIC_SITE_URL=https://www.cineocucina.com

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: new-style secret API key (server only) and CLI access token
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
# Direct Postgres connection string (used by the seed script)
SUPABASE_DB_URL=

# --- Translation (DeepL) — OPTIONAL ----------------------------------------
# Used by `pnpm i18n:translate` to generate EN/DE content from Turkish source.
DEEPL_API_KEY=

# --- Outgoing email (Zoho SMTP) ----------------------------------------------
# ZOHO_SMTP_USER must be the MAILBOX that owns the sending address, which is
# often neither the address mail is sent from nor the address used to sign in
# to Zoho. A domain address like info@example.com is typically an alias, and
# only the mailbox it is attached to may send as it.
#
# Two failures tell these apart, and they look nothing alike:
#   535 Authentication Failed        -> wrong mailbox, wrong password, or wrong
#                                       region host
#   553 Sender is not allowed to relay -> authenticated fine, but this mailbox
#                                       does not own MAIL_FROM
# In Zoho Mail Admin the alias page names its mailbox at the top; that is the
# address to authenticate as, and the app password must be generated for it.
#
# Region matters: smtp.zoho.eu for EU accounts, smtp.zoho.com otherwise. The
# wrong one fails authentication outright, with the same 535 you get from a bad
# password.
#
# The password is a Zoho APP PASSWORD (Zoho -> My Account -> Security -> App
# Passwords); the normal account password is rejected by SMTP.
#
# With these unset the app still stores submissions and just skips the email.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=account-login@example.com
ZOHO_SMTP_PASSWORD=
# What recipients see. Must be an address the account is allowed to send as.
MAIL_FROM=Çi Neo Cucina <info@cineocucina.com>

# Where form submissions are announced. Several addresses may be listed,
# separated by commas — every one of them gets the notification.
RESERVATION_NOTIFICATION_EMAIL=info@cineocucina.com, someone@gmail.com
CONTACT_NOTIFICATION_EMAIL=info@cineocucina.com, someone@gmail.com
